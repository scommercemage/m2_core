{
  "name": "scommerce/core",
  "description": "Scommerce Core Module for Magento 2.0",
  "require": {
    "php": ">=7.2.0"
  },
  "type": "magento2-module",
  "license": "GPL-3.0",
  "version": "2.0.12",
  "authors": [
    {
      "name": "Scommerce Mage",
      "email": "core@scommerce-mage.com"
    }
  ],
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Scommerce\\Core\\": ""
    }
  },
  "require-dev": {
    "magento/magento-coding-standard": "^41",
    "phpstan/phpstan": "^2.1",
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/extension-installer": "^1.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
